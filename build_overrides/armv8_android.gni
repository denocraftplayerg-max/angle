declare_args() {
  # ARMv8.0-A baseline for Android AArch64.
  #
  # Do not use -march=native or -mcpu=native.
  # Do not select ARMv8.1-A or newer explicitly.
  angle_armv80_strict = true

  angle_armv80_arch_flags = [
    "-march=armv8-a",
    "-mtune=generic",
  ]

  angle_armv80_asm_flags = [
    "-march=armv8-a",
  ]
}
